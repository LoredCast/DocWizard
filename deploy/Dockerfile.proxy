# Caddy with the static files under /srv/static/<release>/ (ARCHITECTURE.md §18.1).
# The Harper grammar checker (§6.8) is fetched, checked against its pinned SHA-256, in a build stage.
FROM python:3.12-alpine AS harper
COPY deploy/fetch_tools.py /fetch_tools.py
RUN python3 -I /fetch_tools.py --harper /harper

FROM caddy:2.10-alpine

ARG RELEASE=0.1.0
COPY web /srv/static/${RELEASE}
COPY --from=harper /harper /srv/static/${RELEASE}/vendor/harper
COPY deploy/Caddyfile /etc/caddy/Caddyfile
