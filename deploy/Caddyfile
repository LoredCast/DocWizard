# Two hosts: the app, and the publish host that also serves previews (ARCHITECTURE.md §18.1).
# Default Compose runs behind an external TLS-terminating reverse proxy: use http:// hostnames
# (e.g. DOCWIZARD_APP_HOST=http://write.example.org) and trust forwarded headers from the proxy.
# With opt-in SSL (deploy/compose.ssl.yaml), pass bare hostnames so Caddy obtains certificates.
{
	servers {
		trusted_proxies static {$DOCWIZARD_TRUSTED_PROXIES:private_ranges}
	}
}

{$DOCWIZARD_APP_HOST} {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy unix//run/docwizard/app.sock
	}
}

{$DOCWIZARD_PUBLISH_HOST} {
	encode zstd gzip

	# Previews: served by the app through capability URLs; the app sets their headers.
	handle /_preview/* {
		reverse_proxy unix//run/docwizard/app.sock
	}

	handle {
		root * /srv/publish
		header {
			Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}
}
