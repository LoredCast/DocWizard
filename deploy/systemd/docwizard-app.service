# DocWizard app server (ARCHITECTURE.md §18.2).
# Expects a checkout in /opt/docwizard with a virtualenv in /opt/docwizard/.venv
# and the config in /etc/docwizard/docwizard.toml.
[Unit]
Description=DocWizard app
After=network.target docwizard-worker.service
Wants=docwizard-worker.service

[Service]
Type=simple
User=docwizard-app
Group=docwizard-app
WorkingDirectory=/opt/docwizard
Environment=PYTHONPATH=/opt/docwizard/server
Environment=DOCWIZARD_CONFIG=/etc/docwizard/docwizard.toml
ExecStart=/opt/docwizard/.venv/bin/python -m docwizard serve
Restart=on-failure
RuntimeDirectory=docwizard
RuntimeDirectoryMode=0755

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/docwizard /var/lib/docwizard-publish /var/lib/docwizard-jobs /var/lib/docwizard-cache

[Install]
WantedBy=multi-user.target
