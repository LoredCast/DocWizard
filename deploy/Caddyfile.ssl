# Opt-in TLS Caddyfile for deploy/compose.ssl.yaml (ARCHITECTURE.md §18.1).
# Set DOCWIZARD_APP_HOST and DOCWIZARD_PUBLISH_HOST to bare domain names (without http://).
{
	servers {
		trusted_proxies static {$DOCWIZARD_TRUSTED_PROXIES:private_ranges}
	}
}

{$DOCWIZARD_APP_HOST} {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static
		@shipped file
		handle @shipped {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# Not in this image: the app image comes from another build (pulled between two image
		# pushes) and links its own release's folder. The app serves those files itself.
		handle {
			rewrite * /static{uri}
			reverse_proxy unix//run/docwizard/app.sock
		}
	}

	handle {
		reverse_proxy unix//run/docwizard/app.sock
	}
}

{$DOCWIZARD_PUBLISH_HOST} {
	encode zstd gzip

	# Previews: served by the app through capability URLs; the app sets their headers.
	handle /_preview/* {
		reverse_proxy unix//run/docwizard/app.sock
	}

	# Sites behind a password and the readers' typo form: served by the app, which sets
	# their headers (§14.4). Password-protected sites never sit in /srv/publish.
	handle /_site/* {
		reverse_proxy unix//run/docwizard/app.sock
	}

	handle /_report/* {
		reverse_proxy unix//run/docwizard/app.sock
	}

	# Unlisted publications (/u-...) are never indexed. Public ones follow DOCWIZARD_PUBLIC_ROBOTS:
	# "all" (default) or "noindex, nofollow"; set [server] index_public_sites to match (§14.4).
	handle /u-* {
		root * /srv/publish
		header {
			Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			X-Robots-Tag "noindex, nofollow"
		}
		file_server
	}

	handle {
		root * /srv/publish
		header {
			Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			X-Robots-Tag "{$DOCWIZARD_PUBLIC_ROBOTS:all}"
		}
		file_server
	}
}
