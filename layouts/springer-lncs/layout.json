{
  "id": "springer-lncs",
  "name": "Springer LNCS",
  "version": "1.0.0",
  "extends": "default",
  "description": "After Springer's guidelines for Lecture Notes in Computer Science proceedings (llncs): a 12.2 × 19.3 cm text block, 10 pt New Computer Modern, sections numbered 1 and 1.1 in bold, run-in third-level headings, a small indented abstract, “Fig. 1.” and “Table 1.” captions, numbered references.",
  "design": {
    "page.paper": "a4",
    "page.margin-left": "4.4cm",
    "page.margin-right": "4.4cm",
    "page.margin-top": "5.2cm",
    "page.margin-bottom": "5.2cm",
    "page.number-position": "top-right",
    "text.font": "New Computer Modern",
    "text.size": 10,
    "text.leading": 1.05,
    "text.paragraph-spacing": "0",
    "text.indent": "15pt",
    "text.lang": "en-GB",
    "text.justify": true,
    "heading.numbering": "1",
    "heading.1.size": 1.2,
    "heading.1.weight": "bold",
    "heading.1.above": "1.6em",
    "heading.1.below": "0.8em",
    "heading.2.size": 1,
    "heading.2.weight": "bold",
    "heading.2.above": "1.2em",
    "heading.2.below": "0.6em",
    "heading.3.size": 1,
    "heading.3.weight": "bold",
    "heading.3.run-in": "period",
    "heading.4.size": 1,
    "heading.4.weight": "regular",
    "heading.4.style": "italic",
    "heading.4.run-in": "period",
    "cover.title-size": 1.4,
    "cover.title-weight": "bold",
    "cover.fields": [
      {
        "key": "author"
      },
      {
        "key": "affiliation",
        "style": "small"
      },
      {
        "key": "email",
        "style": "small"
      },
      {
        "key": "abstract"
      },
      {
        "key": "keywords",
        "label": "Keywords: ",
        "style": "small"
      }
    ],
    "cover.abstract-title": "Abstract.",
    "cover.abstract-separator": "space",
    "footnote.size": 0.9,
    "cite.style": "springer-lecture-notes-in-computer-science",
    "bib.heading": "references",
    "bib.size": 0.9,
    "bib.hanging": "0",
    "bib.spacing": "0.2em",
    "caption.figure": "Fig.",
    "caption.table": "Table",
    "caption.separator": ". ",
    "caption.label-weight": "bold",
    "caption.size": 0.9,
    "caption.table-position": "top"
  },
  "variables": {
    "citation-style": {
      "type": "enum",
      "values": [
        "springer-lecture-notes-in-computer-science"
      ],
      "labels": {
        "springer-lecture-notes-in-computer-science": "Springer LNCS"
      },
      "label": "Citation style"
    }
  }
}
