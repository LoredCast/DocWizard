{
  "id": "default",
  "name": "Default",
  "version": "2.0.0",
  "description": "Clean single-column output. A4, 11 pt, Chicago author-date citations by default.",
  "targets": {
    "html": {
      "template": "html/template.html",
      "css": [
        "html/style.css",
        "html/design.css"
      ]
    },
    "pdf-typst": {
      "template": "typst/template.typ"
    },
    "docx": {},
    "odt": {}
  },
  "defaultPdf": "pdf-typst",
  "filters": [
    "crossref"
  ],
  "design": {},
  "variables": {
    "papersize": {
      "type": "enum",
      "values": [
        "a4",
        "us-letter"
      ],
      "label": "Paper size"
    },
    "fontsize": {
      "type": "enum",
      "values": [
        "10pt",
        "11pt",
        "12pt"
      ],
      "label": "Font size"
    },
    "linestretch": {
      "type": "number",
      "min": 1,
      "max": 2,
      "step": 0.25,
      "label": "Line spacing"
    },
    "section-numbering": {
      "type": "enum",
      "values": [
        "",
        "1.1",
        "1.a",
        "I.1"
      ],
      "label": "Section numbering"
    },
    "toc": {
      "type": "boolean",
      "label": "Table of contents"
    },
    "citation-style": {
      "type": "enum",
      "values": [
        "chicago-author-date",
        "chicago-notes-bibliography",
        "chicago-shortened-notes-bibliography",
        "chicago-notes-bibliography-subsequent-author-title-17th-edition",
        "chicago-shortened-notes-bibliography-17th-edition",
        "chicago-author-date-17th-edition",
        "apa",
        "modern-language-association",
        "harvard-cite-them-right",
        "ieee",
        "american-physics-society",
        "oxford-guide-to-style-notes",
        "din-1505-2",
        "uni-wien-philosophie",
        "uni-wien-philosophie-kurzbelege",
        "mhra-notes",
        "mhra-author-date",
        "wuerzburg-germanistik"
      ],
      "labels": {
        "chicago-author-date": "Chicago author-date (18th ed.)",
        "chicago-notes-bibliography": "Chicago notes and bibliography (18th ed.)",
        "chicago-shortened-notes-bibliography": "Chicago shortened notes (18th ed.)",
        "chicago-notes-bibliography-subsequent-author-title-17th-edition": "Chicago notes and bibliography (17th ed., Turabian 9th ed.)",
        "chicago-shortened-notes-bibliography-17th-edition": "Chicago shortened notes (17th ed., Turabian 9th ed.)",
        "chicago-author-date-17th-edition": "Chicago author-date (17th ed., Turabian 9th ed.)",
        "apa": "APA 7th edition",
        "modern-language-association": "MLA 9th edition",
        "harvard-cite-them-right": "Harvard (Cite Them Right)",
        "ieee": "IEEE",
        "american-physics-society": "American Physical Society",
        "oxford-guide-to-style-notes": "Oxford Guide to Style (notes)",
        "din-1505-2": "DIN 1505-2 (German)",
        "uni-wien-philosophie": "Uni Wien Philosophie (footnotes)",
        "uni-wien-philosophie-kurzbelege": "Uni Wien Philosophie (short citations)",
        "mhra-notes": "MHRA 4th edition (notes)",
        "mhra-author-date": "MHRA 4th edition (author-date)",
        "wuerzburg-germanistik": "Würzburg Germanistik (short citations)"
      },
      "label": "Citation style"
    }
  }
}
