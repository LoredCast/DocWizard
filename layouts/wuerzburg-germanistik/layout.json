    "page.number-position": "bottom-center",
    "text.font": "Tinos",
    "text.size": 12,
    "text.leading": 1.5,
    "text.paragraph-spacing": "1em",
    "text.indent": "0",
    "text.justify": true,
    "text.hyphenate": true,
    "text.lang": "de-DE",
    "heading.numbering": "1",
    "heading.1.size": 1.17,
    "heading.2.size": 1.08,
    "heading.3.size": 1,
