{
  "id": "term-paper",
  "name": "Term paper",
  "version": "2.0.0",
  "extends": "default",
  "description": "A4, 12 pt, 1.5 line spacing, title page, numbered sections, Chicago author-date.",
  "design": {
    "text.size": 12,
    "text.leading": 1.5,
    "heading.numbering": "1",
    "heading.1.size": 1.3,
    "heading.2.size": 1.15,
    "heading.3.size": 1,
    "cover.page": true,
    "cover.fields": [
      {
        "key": "institution",
        "style": "large"
      },
      {
        "space": "4em"
      },
      {
        "key": "author"
      },
      {
        "key": "course"
      },
      {
        "key": "date"
      }
    ],
    "bib.title": "",
    "bib.hanging": "2em"
  },
  "variables": {
    "fontsize": {
      "type": "enum",
      "values": [
        "11pt",
        "12pt"
      ],
      "label": "Font size"
    },
    "linestretch": {
      "type": "number",
      "min": 1,
      "max": 2,
      "step": 0.25,
      "label": "Line spacing"
    },
    "section-numbering": {
      "type": "enum",
      "values": [
        "",
        "1.1",
        "1.a",
        "I.1"
      ],
      "label": "Section numbering"
    },
    "titlepage": {
      "type": "boolean",
      "label": "Title page"
    },
    "institution": {
      "type": "string",
      "default": "",
      "label": "Institution"
    }
  }
}
