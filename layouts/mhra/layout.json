{
  "id": "mhra",
  "name": "MHRA essay",
  "version": "1.0.0",
  "extends": "default",
  "description": "After the MHRA Style Guide (4th ed., 2024): A4, 12 pt Tinos (Times New Roman metrics) in one size throughout, 1.5 line spacing, indented paragraphs, bold headings and italic subheadings, single quotation marks, indented long quotations, MHRA notes and bibliography.",
  "design": {
    "page.paper": "a4",
    "text.font": "Tinos",
    "text.size": 12,
    "text.leading": 1.5,
    "text.paragraph-spacing": "0",
    "text.indent": "0.5in",
    "text.justify": false,
    "text.lang": "en-GB",
    "text.quotes": "single",
    "text.date-format": "day-month-year",
    "heading.numbering": "",
    "heading.1.size": 1,
    "heading.1.weight": "bold",
    "heading.1.above": "1.6em",
    "heading.1.below": "0.8em",
    "heading.2.size": 1,
    "heading.2.weight": "regular",
    "heading.2.style": "italic",
    "heading.2.above": "1.4em",
    "heading.2.below": "0.6em",
    "heading.3.size": 1,
    "heading.3.weight": "regular",
    "heading.3.style": "italic",
    "heading.4.size": 1,
    "heading.4.weight": "regular",
    "heading.4.style": "italic",
    "cover.align": "left",
    "cover.title-size": 1.3,
    "cover.subtitle-size": 1.1,
    "cover.fields": [
      {
        "key": "author"
      },
      {
        "key": "course"
      },
      {
        "key": "institution"
      },
      {
        "key": "date"
      }
    ],
    "quote.size": 1,
    "quote.leading": 0,
    "quote.indent-left": "0.5in",
    "quote.indent-right": "0",
    "quote.spacing": "1.5em",
    "footnote.size": 1,
    "footnote.leading": 0,
    "footnote.indent": "0",
    "cite.style": "mhra-notes",
    "bib.heading": "bibliography",
    "bib.size": 1,
    "bib.hanging": "0.5in",
    "caption.figure": "Fig.",
    "caption.separator": ". ",
    "caption.size": 1
  },
  "variables": {
    "linestretch": {
      "type": "number",
      "min": 1.5,
      "max": 2,
      "step": 0.5,
      "label": "Line spacing"
    },
    "papersize": {
      "type": "enum",
      "values": [
        "a4",
        "us-letter"
      ],
      "label": "Paper size"
    },
    "titlepage": {
      "type": "boolean",
      "label": "Title page"
    },
    "toc": {
      "type": "boolean",
      "label": "Table of contents"
    },
    "citation-style": {
      "type": "enum",
      "values": [
        "mhra-notes",
        "mhra-author-date"
      ],
      "labels": {
        "mhra-notes": "MHRA 4th edition (notes)",
        "mhra-author-date": "MHRA 4th edition (author-date)"
      },
      "label": "Citation style"
    }
  }
}
