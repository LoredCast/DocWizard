<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="never" default-locale="de-AT" page-range-format="expanded">
  <info>
    <title>Universität Wien – Philosophie (Leitfaden, Fußnoten)</title>
    <title-short>Uni Wien Philosophie</title-short>
    <id>https://github.com/LoredCast/DocWizard/csl/uni-wien-philosophie</id>
    <link href="https://github.com/LoredCast/DocWizard/csl/uni-wien-philosophie" rel="self"/>
    <link href="https://philosophie.univie.ac.at/" rel="documentation"/>
    <author>
      <name>DocWizard</name>
    </author>
    <category citation-format="note"/>
    <category field="philosophy"/>
    <summary>Footnote citations and bibliography after the "Leitfaden für schriftliche Arbeiten im Bachelorstudium Philosophie" (Version 9/2021): notes "Vorname Nachname: Titel. Ort Jahr, Seite.", then "Nachname: Kurztitel, Seite." and "Ebd., Seite."; bibliography "Nachname, Vorname: Titel. Untertitel. Auflage. Ort: Verlag Jahr."</summary>
    <updated>2026-11-16T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="editor" form="short">
        <single>Hg.</single>
        <multiple>Hg.</multiple>
      </term>
      <term name="ibid">ebd.</term>
      <term name="in">in</term>
      <term name="accessed">Zugriff am</term>
      <term name="edition" form="short">Aufl.</term>
      <term name="translator" form="verb-short">übers. v.</term>
    </terms>
  </locale>
  <!-- Names -->
  <macro name="author-note">
    <names variable="author">
      <name delimiter=" / " delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <text macro="title-plain"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <text macro="title-plain"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter=" / " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="container-editor">
    <names variable="editor container-author">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="translator">
    <names variable="translator">
      <label form="verb-short" suffix=" "/>
      <name delimiter=" / " delimiter-precedes-last="never"/>
    </names>
  </macro>
  <!-- Titles -->
  <macro name="title-plain">
    <text variable="title"/>
  </macro>
  <macro name="title">
    <choose>
      <if type="book thesis report manuscript motion_picture" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else-if type="webpage post post-weblog" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <macro name="title-short">
    <choose>
      <if type="book thesis report manuscript motion_picture" match="any">
        <text variable="title" form="short" font-style="italic"/>
      </if>
      <else>
        <text variable="title" form="short" quotes="true"/>
      </else>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="date">
    <date variable="issued" form="numeric" date-parts="year"/>
  </macro>
  <!-- "Ort Jahr" in notes, "Ort: Verlag Jahr" in the bibliography -->
  <macro name="imprint-note">
    <group delimiter=" ">
      <text variable="publisher-place"/>
      <text macro="date"/>
    </group>
  </macro>
  <macro name="imprint-bib">
    <group delimiter=" ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="date"/>
    </group>
  </macro>
  <macro name="journal">
    <group delimiter=", ">
      <group delimiter=" ">
        <text variable="container-title" font-style="italic"/>
        <text variable="volume"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text macro="date"/>
    </group>
  </macro>
  <macro name="access">
    <group delimiter=" ">
      <text variable="URL"/>
      <group prefix="(" suffix=")" delimiter=" ">
        <text term="accessed"/>
        <date variable="accessed" form="numeric"/>
      </group>
    </group>
  </macro>
  <!-- The work after the author: everything except the cited page -->
  <macro name="work-note">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=": ">
            <text term="in" text-case="capitalize-first"/>
            <text macro="container-editor"/>
            <text variable="container-title" font-style="italic"/>
          </group>
          <text macro="imprint-note"/>
        </group>
      </if>
      <else-if type="article-journal article-magazine article-newspaper review" match="any">
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=": ">
            <text term="in" text-case="capitalize-first"/>
            <text macro="journal"/>
          </group>
        </group>
      </else-if>
      <else-if type="webpage post post-weblog" match="any">
        <group delimiter=". ">
          <text macro="title"/>
          <text macro="access"/>
        </group>
      </else-if>
      <else>
        <group delimiter=". ">
          <text macro="title"/>
          <text macro="edition"/>
          <text macro="imprint-note"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="work-bib">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=": ">
            <text term="in" text-case="capitalize-first"/>
            <text macro="container-editor"/>
            <text variable="container-title" font-style="italic"/>
          </group>
          <group delimiter=", ">
            <text macro="imprint-bib"/>
            <text variable="page"/>
          </group>
        </group>
      </if>
      <else-if type="article-journal article-magazine article-newspaper review" match="any">
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=", ">
            <group delimiter=": ">
              <text term="in" text-case="capitalize-first"/>
              <text macro="journal"/>
            </group>
            <text variable="page"/>
          </group>
        </group>
      </else-if>
      <else-if type="webpage post post-weblog" match="any">
        <group delimiter=". ">
          <text macro="title"/>
          <text macro="access"/>
        </group>
      </else-if>
      <else>
        <group delimiter=". ">
          <text macro="title"/>
          <text macro="translator"/>
          <text macro="edition"/>
          <text macro="imprint-bib"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="locator">
    <choose>
      <if locator="page">
        <text variable="locator"/>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation et-al-min="4" et-al-use-first="1">
    <layout suffix="." delimiter="; ">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text term="ibid" text-case="capitalize-first"/>
            <text macro="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid" text-case="capitalize-first"/>
        </else-if>
        <else-if position="subsequent">
          <group delimiter=", ">
            <group delimiter=": ">
              <text macro="author-short"/>
              <text macro="title-short"/>
            </group>
            <text macro="locator"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <group delimiter=": ">
              <text macro="author-note"/>
              <text macro="work-note"/>
            </group>
            <choose>
              <if variable="locator">
                <text macro="locator"/>
              </if>
              <else-if type="chapter paper-conference article-journal article-magazine article-newspaper" match="any">
                <text variable="page"/>
              </else-if>
            </choose>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography hanging-indent="true" et-al-min="11" et-al-use-first="7" subsequent-author-substitute="–" entry-spacing="0">
    <sort>
      <key macro="author-bib"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=": ">
        <text macro="author-bib"/>
        <text macro="work-bib"/>
      </group>
    </layout>
  </bibliography>
</style>
